{
  "name": "actual-budget-mcp",
  "version": "1.0.0",
  "description": "A secure MCP stdio server for Actual Budget.",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "bin": {
    "actual-budget-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:read": "vitest run --config vitest.integration.config.ts test/integration/read.integration.test.ts",
    "test:integration:write": "vitest run --config vitest.integration.config.ts test/integration/write.integration.test.ts",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:e2e:read": "npm run build && vitest run --config vitest.e2e.config.ts test/e2e/read.e2e.test.ts",
    "test:e2e:write": "npm run build && vitest run --config vitest.e2e.config.ts test/e2e/write.e2e.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:contract && npm run test:integration:read && npm run test:e2e:read && npm run build",
    "release:check": "npm run typecheck && npm test && npm run test:contract && npm run build && npm run contract:compatibility:check && npm run inventory:check && npm run errors:check && npm run limits:check && npm run idempotency:check && npm run sync:check && npm run package:check && npm run security:scan && git diff --check",
    "package:check": "npm pack --dry-run --json",
    "security:scan": "tsx scripts/check-repository-hygiene.ts",
    "contract:baseline:generate": "tsx scripts/generate-v070-contract-baseline.ts",
    "contract:compatibility:check": "tsx scripts/check-contract-compatibility.ts",
    "inventory:generate": "tsx scripts/generate-tool-inventory.ts",
    "inventory:check": "tsx scripts/generate-tool-inventory.ts --check",
    "errors:generate": "tsx scripts/generate-error-catalog.ts",
    "errors:check": "tsx scripts/generate-error-catalog.ts --check",
    "limits:generate": "tsx scripts/generate-limits-catalog.ts",
    "limits:check": "tsx scripts/generate-limits-catalog.ts --check",
    "idempotency:generate": "tsx scripts/generate-idempotency-catalog.ts",
    "idempotency:check": "tsx scripts/generate-idempotency-catalog.ts --check",
    "sync:generate": "tsx scripts/generate-sync-semantics-catalog.ts",
    "sync:check": "tsx scripts/generate-sync-semantics-catalog.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@actual-app/api": "26.8.1",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
